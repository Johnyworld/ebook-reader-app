<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- enableOnBackInvokedCallback=false: targetSdk 36에서 기본 활성화되는 예측형 뒤로가기를 끄고 기존 뒤로가기 방식 유지
         (e-ink 기기에서 시스템 뒤로가기 애니메이션 방지, WebView 텍스트 선택 중 뒤로가기 동작 유지) -->
    <application
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.EbookReaderApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.EbookReaderApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 파일 탐색기·이메일 첨부 등에서 책 파일을 눌렀을 때 eera로 열기 (연결 프로그램) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <!-- 구형 파일 탐색기는 EPUB을 형식을 알 수 없는 파일로 넘긴다. 실제 형식은 앱에서 파일명 확장자로 판단 -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>

</manifest>
